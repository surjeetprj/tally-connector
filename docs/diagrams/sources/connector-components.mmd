    classDef externalStyle fill:#f2ecff,stroke:#7953ad,color:#392750;
    class screen screenStyle;
    class worker,engine,bahiAdapter,tallyAdapter workStyle;
    class storage storageStyle;
    class bahi,tally externalStyle;
