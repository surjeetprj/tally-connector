{
  "theme": "base",
  "securityLevel": "strict",
  "htmlLabels": false,
  "fontFamily": "Arial, Helvetica, sans-serif",
  "deterministicIds": true,
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#e8f1ff",
    "primaryTextColor": "#162e49",
    "primaryBorderColor": "#3268a8",
    "lineColor": "#4b5563",
    "secondaryColor": "#e7f5ed",
    "tertiaryColor": "#fff5d6",
    "actorBkg": "#e8f1ff",
    "actorBorder": "#3268a8",
    "actorTextColor": "#162e49",
    "actorLineColor": "#64748b",
    "signalColor": "#4b5563",
    "signalTextColor": "#1f2937",
    "noteBkgColor": "#fff5d6",
    "noteBorderColor": "#a57919",
    "noteTextColor": "#49380d"
  },
  "flowchart": { "htmlLabels": false, "useMaxWidth": true, "nodeSpacing": 35, "rankSpacing": 50 },
  "sequence": {
    "useMaxWidth": true,
    "mirrorActors": false,
    "wrap": true,
    "width": 175,
    "actorMargin": 35,
    "messageMargin": 35,
    "diagramMarginX": 25,
    "diagramMarginY": 25
  }
}
